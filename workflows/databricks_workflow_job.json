{
  "name": "FraudStream_End_to_End_Lakehouse_Pipeline",
  "max_concurrent_runs": 1,
  "timeout_seconds": 0,
  "tasks": [
    {
      "task_key": "fraudstream_orchestrator",
      "notebook_task": {
        "notebook_path": "notebooks/00_run_all_pipeline",
        "source": "WORKSPACE",
        "base_parameters": {
          "run_mode": "{{job.parameters.run_mode}}"
        }
      },
      "timeout_seconds": 0
    }
  ],
  "parameters": [
    {
      "name": "run_mode",
      "default": "BATCH"
    }
  ],
  "format": "MULTI_TASK"
}
