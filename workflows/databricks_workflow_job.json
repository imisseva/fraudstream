{
  "name": "FraudStream_End_to_End_Lakehouse_Pipeline",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "01_bronze_ingestion",
      "description": "Ingest transaction-events and clickstream-events from Aiven Kafka into Bronze Delta tables",
      "notebook_task": {
        "notebook_path": "notebooks/01_fraudstream_ingestion",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "02_silver_quality",
      "description": "Normalize timestamps, enforce Data Quality rules, quarantine errors (DLQ), and profile user sessions",
      "depends_on": [
        {
          "task_key": "01_bronze_ingestion"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_fraudstream_silver_quality",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "03_gold_fraud_detection",
      "description": "Correlate transactions with clickstream profiles, detect 7 fraud scenarios, upsert to Gold via Delta MERGE, and compute Confusion Matrix",
      "depends_on": [
        {
          "task_key": "02_silver_quality"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_fraudstream_gold_detection",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "04_analytics_dashboard",
      "description": "Generate Executive Fraud KPIs, Channel & Geographic Risk distribution, and top incident reports",
      "depends_on": [
        {
          "task_key": "03_gold_fraud_detection"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/04_fraud_dashboard_analytics",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 300
    }
  ],
  "parameters": [
    {
      "name": "kafka_password",
      "default": ""
    }
  ],
  "format": "MULTI_TASK"
}

