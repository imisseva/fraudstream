# ==============================================================================
# FraudStream Simulator Environment Variables Template
# Copy file này thành .env và điền thông tin cụm Aiven Kafka của bạn
# ==============================================================================

# Kafka Broker & Topics
BOOTSTRAP_SERVERS=flaudstream-smartwasher-server.g.aivencloud.com:27404
TOPIC_TRANSACTIONS=transaction-events
TOPIC_CLICKSTREAM=clickstream-events

# Security (SASL_SSL / SCRAM-SHA-256 for Aiven Cloud)
SECURITY_PROTOCOL=SASL_SSL
SASL_MECHANISM=SCRAM-SHA-256
SASL_USERNAME=avnadmin
SASL_PASSWORD=your_aiven_password_here

# SSL CA Certificate (Tải ca.pem từ tab Overview trên Aiven Console)
KAFKA_CA_PATH=ca.pem

# Databricks cluster environment (password is configured as a Databricks Secret,
# never as a widget or Workflow parameter)
DATABRICKS_SECRET_SCOPE=fraudstream
DATABRICKS_KAFKA_PASSWORD_KEY=aiven-kafka-password

# Traffic & Simulation Controls
RATE=20.0
USERS=1000
DRY_RUN=false

